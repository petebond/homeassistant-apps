  "plans": [
   {
    "id": 1,
    "scenario": "Power cut",
    "steps": "Report it: call 105 (England, Scotland, Wales) or 03457 643643 (Northern Ireland).\nUse torches, not candles.\nUse the battery or wind-up radio for news.\nCheck on neighbours who may be at risk.\nIf you need to leave, turn off gas, electricity and water.",
    "meeting_point": "",
    "roles": "",
    "grab_bag": "",
    "notes": "",
    "info_url": "https://beready.campaign.gov.uk/be-informed-about-hazards/power-cuts/",
    "last_reviewed": "2026-10-23",
    "sort": 0
   },
   {
    "id": 2,
    "scenario": "Flooding",
    "steps": "Check your flood risk and flood insurance in advance.\nAgree with everyone at home what you will do if the house floods.\nFollow emergency services' advice. Evacuate when told to.\nIf you need to leave, turn off gas, electricity and water. Take the grab bag.",
    "meeting_point": "",
    "roles": "",
    "grab_bag": "",
    "notes": "",
    "info_url": "https://beready.campaign.gov.uk/be-informed-about-hazards/flooding/",
    "last_reviewed": null,
    "sort": 1
   },
   {
    "id": 3,
    "scenario": "Fire in the home",
    "steps": "Get everyone out using the planned escape route. Call 999.\nDo not go back inside.\nMeet at the meeting point near home.\nIn advance: test smoke alarms monthly and book a home fire safety check.",
    "meeting_point": "",
    "roles": "",
    "grab_bag": "",
    "notes": "",
    "info_url": "https://beready.campaign.gov.uk/be-informed-about-hazards/fires-in-the-home/",
    "last_reviewed": null,
    "sort": 2
   },
   {
    "id": 4,
    "scenario": "Evacuation",
    "steps": "Leave when told to by the emergency services.\nTake the grab bag and medication.\nTurn off gas, electricity and water if you have time.\nGo to the agreed meeting point; let the emergency contact know where you are.",
    "meeting_point": "",
    "roles": "",
    "grab_bag": "",
    "notes": "",
    "info_url": "https://beready.campaign.gov.uk/be-ready-for-emergencies/",
    "last_reviewed": null,
    "sort": 3
   },
   {
    "id": 5,
    "scenario": "Severe weather (storms, snow and ice, heatwave)",
    "steps": "Check Met Office weather warnings: https://www.metoffice.gov.uk/\nGo in, Stay in, Tune in.\nCheck on neighbours who may be at risk.\nIf travelling in wintry weather, carry the car kit.",
    "meeting_point": "",
    "roles": "",
    "grab_bag": "",
    "notes": "",
    "info_url": "https://beready.campaign.gov.uk/be-informed-about-hazards/storms/",
    "last_reviewed": null,
    "sort": 4
   },
   {
    "id": 6,
    "scenario": "Water supply interruption",
    "steps": "Use stored drinking water: 3 litres per person per day.\nContact the water supplier (see Household details) for updates.\nUse ready-to-feed formula for babies rather than making up powder.",
    "meeting_point": "",
    "roles": "",
    "grab_bag": "",
    "notes": "",
    "info_url": "https://beready.campaign.gov.uk/be-informed-about-hazards/water-supply-interruptions-or-outages/",
    "last_reviewed": null,
    "sort": 5
   },
   {
    "id": 7,
    "scenario": "Phone and broadband outage",
    "steps": "Use the battery or wind-up FM radio for news (frequencies in Household details).\nUse the printed contact list.\nIf someone cannot be reached by phone, follow the backup plan (e.g. a trusted person visits them).\nGo to the meeting point if agreed.",
    "meeting_point": "",
    "roles": "",
    "grab_bag": "",
    "notes": "",
